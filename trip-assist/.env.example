# ── APIキー設定 ──────────────────────────────────────────────
# このファイルをコピーして .env にリネームし、実際のキーを入力してください。
# .env は Git にコミットしないでください（.gitignore で除外済み）。

# Gemini API キー（必須）
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Geocoding API キー（省略可・スポットのピン留めに使用）
# 取得先: https://console.cloud.google.com/ → Geocoding API を有効化
MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
